# KaffePOS backend staging environment template.
# Placeholders only. Do not commit real secrets.

# A. Minimal staging required (core app smoke without external providers)
NODE_ENV=staging
STAGING_PROFILE=minimal
WEB_BASE_URL=https://staging.example.com
API_BASE_URL=https://staging-api.example.com
CORS_ORIGIN=https://staging.example.com
PORT=8787

DATABASE_URL=postgresql://user:password@host:5432/kaffepos_staging
JWT_SECRET=change-me
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me-32-byte-key

PAYMENT_INTEGRATION_ENABLED=false
EMAIL_INTEGRATION_ENABLED=false
R2_STORAGE_ENABLED=false
ANALYTICS_SERVER_ENABLED=false

# B. Full staging required (production-candidate external provider verification)
# Required only when STAGING_PROFILE=full/unset.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SNAP_ENABLED=true
MIDTRANS_SERVER_KEY=SB-Mid-server-change-me
MIDTRANS_CLIENT_KEY=SB-Mid-client-change-me

RESEND_API_KEY=re_change_me
RESEND_FROM_EMAIL=KaffePOS Staging <noreply@example.com>
EMAIL_REPLY_TO=support@example.com

CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_R2_ACCESS_KEY_ID=change-me
CLOUDFLARE_R2_SECRET_ACCESS_KEY=change-me
CLOUDFLARE_R2_BUCKET=kaffepos-staging-assets
CLOUDFLARE_R2_PUBLIC_URL=https://assets-staging.example.com

GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=change-me

# Feature flags
AFFILIATE_REFERRAL_ENABLED=false
REFERRAL_ENABLED=false
AFFILIATE_ENABLED=false
ADMIN_COMMISSION_ENABLED=false
REFERRAL_COMMISSION_CREATION_ENABLED=false

# C. Optional integrations skipped in minimal mode
# Midtrans, Resend, Cloudflare/R2, GA4, and server analytics may remain placeholders in minimal staging.

# DOKU sandbox staging — DOKU is the ACTIVE payment gateway.
# The backend env schema (backend/src/core/env.ts) ONLY accepts:
#   PAYMENT_GATEWAY_PROVIDER = doku | disabled
#   SUBSCRIPTION_PAYMENT_MODE = manual | disabled | doku_sandbox | doku_production
# Any other value (e.g. the old "duitku") fails validation and the backend will
# not boot. Online payment activates only when provider=doku AND all three of
# DOKU_CLIENT_ID + DOKU_SECRET_KEY + DOKU_CALLBACK_URL are set (isDokuConfigured()).
PAYMENT_GATEWAY_PROVIDER=doku
PAYMENT_INTEGRATION_ENABLED=true
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=change-me
DOKU_SECRET_KEY=change-me
DOKU_CALLBACK_URL=https://api.kaffepos.my.id/api/webhooks/doku
SUBSCRIPTION_PAYMENT_MODE=doku_sandbox

# Payment staging profile (DOKU sandbox)
# STAGING_PROFILE=payment
# PAYMENT_GATEWAY_PROVIDER=doku
# PAYMENT_INTEGRATION_ENABLED=true
# DOKU_ENVIRONMENT=sandbox
# DOKU_CLIENT_ID=ISI_DARI_DOKU
# DOKU_SECRET_KEY=ISI_DARI_DOKU
# DOKU_CALLBACK_URL=https://api.kaffepos.my.id/api/webhooks/doku
# SUBSCRIPTION_PAYMENT_MODE=doku_sandbox
#
# For production: DOKU_ENVIRONMENT=production and SUBSCRIPTION_PAYMENT_MODE=doku_production.
# Legacy Midtrans/Duitku keys are NOT read by the code and may be omitted.
