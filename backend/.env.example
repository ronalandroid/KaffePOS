# KaffePOS backend API
# Copy to backend/.env and adjust to your server environment.
# Production target example: https://api.kaffepos.my.id

SERVICE_NAME=kaffepos-backend
APP_VERSION=1.0.0
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
ADMIN_EMAILS=kaffeposapp@gmail.com
SESSION_TTL_DAYS=30
EMAIL_CODE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=60
WEB_BASE_URL=https://kaffepos.my.id
API_BASE_URL=https://api.kaffepos.my.id

# Cloudflare CDN / Images / R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=kaffepos-assets
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.kaffepos.my.id
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_DELIVERY_URL=

# InsForge Cloud & PostgreSQL Database (prefer DATABASE_URL in staging/production).
INSFORGE_PROJECT_ID=0246a183-d8b0-4de6-8d41-9240e2380d50
INSFORGE_URL=https://6x4q2bgn.ap-southeast.insforge.app
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
DATABASE_URL=postgresql://postgres:replace-me@6x4q2bgn.ap-southeast.database.insforge.app:5432/insforge?sslmode=require
DB_HOST=6x4q2bgn.ap-southeast.database.insforge.app
DB_PORT=5432
DB_NAME=insforge
DB_USER=postgres
DB_PASSWORD=replace-me
DB_SSL=true
# Keep certificate verification on when DB_SSL=true. Set CA when your provider needs a custom root cert.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=

# Email delivery via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=KaffePOS <no-reply@kaffepos.my.id>

# Midtrans subscription payments
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_SNAP_ENABLED=true
MIDTRANS_WEBHOOK_BASE_URL=https://api.kaffepos.my.id
MIDTRANS_FINISH_URL=https://kaffepos.my.id/settings?billing=success
MIDTRANS_UNFINISH_URL=https://kaffepos.my.id/settings?billing=pending
MIDTRANS_ERROR_URL=https://kaffepos.my.id/settings?billing=failed
SUBSCRIPTION_PAYMENT_MODE=auto

# Abuse protection
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_EMAIL_RATE_LIMIT_MAX=5
AUTH_VERIFY_RATE_LIMIT_MAX=20
PAYMENT_CREATE_RATE_LIMIT_MAX=12

# MIDTRANS_SERVER_KEY stays backend-only. Never expose it as VITE_*.

# Optional for /api/ai-insight. Leave empty if AI insight is not used yet.
GEMINI_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Comma-separated. Leave empty to use sane defaults.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://kaffepos.my.id,https://www.kaffepos.my.id,https://api.kaffepos.my.id,capacitor://localhost,https://localhost,http://localhost

# Payment provider abstraction (Mayar Headless API v2 — https://docs.mayar.id)
PAYMENT_GATEWAY_PROVIDER=mayar
PAYMENT_INTEGRATION_ENABLED=true
MAYAR_ENVIRONMENT=sandbox
MAYAR_API_KEY=change-me
MAYAR_WEBHOOK_TOKEN=change-me
MAYAR_SANDBOX_BASE_URL=https://api.mayar.club
MAYAR_PRODUCTION_BASE_URL=https://api.mayar.id
MAYAR_REDIRECT_URL=https://kaffepos.my.id/settings?billing=mayar-return
MAYAR_CALLBACK_URL=https://api.kaffepos.my.id/api/webhooks/mayar
SUBSCRIPTION_PAYMENT_MODE=mayar_sandbox
PII_ENCRYPTION_KEY=change-me-in-production
